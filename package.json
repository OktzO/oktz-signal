{
  "name": "oktz-signal",
  "version": "0.3.0-rc.1",
  "type": "module",
  "description": "Signal protocol Rust native — MIT replacement for libsignal (GPL)",
  "main": "index.js",
  "license": "MIT",
  "files": [
    "index.js",
    "src/",
    "native/signal/index.cjs",
    "napi.config.json"
  ],
  "scripts": {
    "build:native": "napi build --release --platform --js-package-name @oktz-signal/signal --config-path napi.config.json --manifest-path native/signal/Cargo.toml --output-dir native/signal --js index.cjs",
    "build:source": "cargo build --manifest-path native/signal/Cargo.toml --release --locked",
    "build": "npm run build:native",
    "test": "node --test",
    "test:rust": "cargo test --manifest-path native/signal/Cargo.toml",
    "test:all": "npm run test:rust && npm test",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.4",
    "js-yaml": "5.4.2",
    "libsignal": "^6.0.0"
  },
  "optionalDependencies": {
    "@oktz-signal/signal-linux-arm64-gnu": "0.3.0-rc.1",
    "@oktz-signal/signal-linux-arm64-musl": "0.3.0-rc.1",
    "@oktz-signal/signal-linux-x64-gnu": "0.3.0-rc.1",
    "@oktz-signal/signal-linux-x64-musl": "0.3.0-rc.1"
  }
}
